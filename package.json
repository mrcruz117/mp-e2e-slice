{
  "name": "mp-e2e-slice",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.build.json",
    "start": "node dist/server/server.js",
    "demo": "npm run build && node scripts/demo.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "oracle:vendor": "node scripts/oracle.ts vendor",
    "oracle:derive": "node scripts/oracle.ts derive",
    "oracle:upstream": "node scripts/oracle.ts upstream"
  },
  "dependencies": {
    "@fastify/static": "^10.1.2",
    "fast-xml-parser": "^5.10.1",
    "fastify": "^5.10.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
